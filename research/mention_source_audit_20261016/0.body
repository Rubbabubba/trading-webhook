i-analysis/contents/src%2Fkalshi%2Ftest_runner.py?ref=9c9b285f81215bfc7a982dcbcf4559e0991d92d4"},{"sha":"fb81fb6c45ff3e89a9e462a89fb1da35fe951e68","filename":"src/kalshi/url_parser.py","status":"added","additions":295,"deletions":0,"changes":295,"blob_url":"https://github.com/DanMcInerney/kalshi-analysis/blob/9c9b285f81215bfc7a982dcbcf4559e0991d92d4/src%2Fkalshi%2Furl_parser.py","raw_url":"https://github.com/DanMcInerney/kalshi-analysis/raw/9c9b285f81215bfc7a982dcbcf4559e0991d92d4/src%2Fkalshi%2Furl_parser.py","contents_url":"https://api.github.com/repos/DanMcInerney/kalshi-analysis/contents/src%2Fkalshi%2Furl_parser.py?ref=9c9b285f81215bfc7a982dcbcf4559e0991d92d4"},{"sha":"608b7fe7363407481befd7000de2f3c119fea5b8","filename":"src/roi_calculator/__init__.py","status":"added","additions":89,"deletions":0,"changes":89,"blob_url":"https://github.com/DanMcInerney/kalshi-analysis/blob/9c9b285f81215bfc7a982dcbcf4559e0991d92d4/src%2Froi_calculator%2F__init__.py","raw_url":"https://github.com/DanMcInerney/kalshi-analysis/raw/9c9b285f81215bfc7a982dcbcf4559e0991d92d4/src%2Froi_calculator%2F__init__.py","contents_url":"https://api.github.com/repos/DanMcInerney/kalshi-analysis/contents/src%2Froi_calculator%2F__init__.py?ref=9c9b285f81215bfc7a982dcbcf4559e0991d92d4"},{"sha":"ce77a0f073b11fec709d017ed6ba6c9202c0c99c","filename":"src/roi_calculator/backtest.py","status":"added","additions":299,"deletions":0,"changes":299,"blob_url":"https://github.com/DanMcInerney/kalshi-analysis/blob/9c9b285f81215bfc7a982dcbcf4559e0991d92d4/src%2Froi_calculator%2Fbacktest.py","raw_url":"https://github.com/DanMcInerney/kalshi-analysis/raw/9c9b285f81215bfc7a982dcbcf4559e0991d92d4/src%2Froi_calculator%2Fbacktest.py","contents_url":"https://api.github.com/repos/DanMcInerney/kalshi-analysis/contents/src%2Froi_calculator%2Fbacktest.py?ref=9c9b285f81215bfc7a982dcbcf4559e0991d92d4"},{"sha":"379e6ae731cc9120f736dcfcbe1986bc480e9790","filename":"src/roi_calculator/calculator.py","status":"added","additions