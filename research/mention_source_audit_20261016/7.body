"""Compare entry pricing: trade-derived vs price_snapshot NO bid.

Runs a spread sweep using both price sources to see if optimal adj shifts.

Usage: uv run python -m analysis.mention.snapshot_vs_trades
"""

import gc
import time

import numpy as np
import pandas as pd

from analysis.lib.fills import simulate_fills, weekly_sharpe
from analysis.lib.queries import load_entries, load_post_entry_trades
from analysis.lib.db import FILL_TOL, OUT_BASE, connect, run_query, MIN_MARKET_VOL, \
    BOT_SKIP_SERIES, BOT_SKIP_WORDS
from analysis.mention.queue_depth import detect_sweeps, compute_queue_depth

OUT_DIR = OUT_BASE / "mention"

ADJ_VALUES = [-3, -2, -1, 0, 1, 2]
TARGET_SIZE = 100


def load_snapshot_entries(con):
    """Load T-24h entry prices from price_snapshots (NO bid = 1 - yes_ask)."""
    return run_query(con, f"""
    SELECT ps.ticker, m.event_ticker, m.result, m.volume AS market_vol,
           CAST(ROUND((1.0 - ps.yes_ask) * 100) AS INTEGER) AS entry_no_price,
           ps.snapshot_ts AS entry_time, m.close_time
    FROM price_snapshots ps
    JOIN markets m ON ps.ticker = m.ticker
    JOIN events e ON m.event_ticker = e.event_ticker
    WHERE ps.interval_name = '24h'
      AND m.result IN ('yes', 'no')
      AND e.mutually_exclusive = false AND e.category = 'Mentions'
      AND ps.yes_ask IS NOT NULL AND ps.yes_ask > 0.01 AND ps.yes_ask < 0.99
      AND m.close_time >= '2025-10-01'
      {BOT_SKIP_SERIES}
      {BOT_SKIP_WORDS}
      AND m.volume >= {MIN_MARKET_VOL}
    """, "T-24h snapshot entries")


def run_sweep(entries, post_trades, depth_map, label):
    """Run adj sweep and return results DataFrame."""
    rows = []
    for adj in ADJ_VALUES:
        bsm = {t: TARGET_SIZE / (TARGET_SIZE + d) for t, d in depth_map.items()}
        sim = simulate_fills(
            entries, post_trades,
            target_size=TARGET_SIZE,
            book_share_map=bsm,
            adverse_mode="expected",
            spread_adj=adj,
        )
        filled = sim[sim["filled"] > 0]
        total_pnl = sim["pnl"].sum()
        total_filled = filled["filled"].sum() if len(filled) > 0 else 0
        n_filled = len(filled)
        sharpe = weekly_sharpe(filled["pnl"], filled["close_time"]) if n_filled >= 5 else float("nan")
        rows.append({
            "source": label,
            "adj": adj,
            "total_pnl": total_pnl,
            "total_filled": total_filled,
            "pnl_per_ct": total_pnl / total_filled if total_filled > 0 else 0,
            "sharpe": sharpe,
            "n_entered": len(sim),
            "n_filled": n_filled,
        })
    return pd.DataFrame(rows)


def main():
    t0 = time.time()
    OUT_DIR.mkdir(parents=True, exist_ok=True)

    print("Loading data...")
    con = connect()
    entries_trade = load_entries(con)
    entries_snap = load_snapshot_entries(con)
    post_trades = load_post_entry_trades(con)
    con.close()

    print(f"  Trade-derived entries: {len(entries_trade):,}")
    print(f"  Snapshot entries: {len(entries_snap):,}")
    print(f"  Post-entry trades: {len(post_trades):,}")

    # Find common tickers
    common = set(entries_trade["ticker"]) & set(entries_snap["ticker"])
    print(f"  Common tickers: {len(common):,}")

    # Filter both to common tickers for fair comparison
    entries_trade_c = entries_trade[entries_trade["ticker"].isin(common)].copy()
    entries_snap_c = entries_snap[entries_snap["ticker"].isin(common)].copy()

    # Price comparison
    trade_prices = entries_trade_c.set_index("ticker")["entry_no_price"]
    snap_prices = entries_snap_c.set_index("ticker")["entry_no_price"]
    common_idx = trade_prices.index.intersection(snap_prices.index)
    diff = trade_prices.loc[common_idx] - snap_prices.loc[common_idx]

    print(f"\n  Price comparison ({len(common_idx):,} markets):")
    print(f"    Trade - Snapshot NO bid: median={diff.median():+.1f}c, "
          f"mean={diff.mean():+.1f}c, std={diff.std():.1f}c")
    print(f"    |diff| <= 1c: {(diff.abs() <= 1).mean()*100:.0f}%, "
          f"|diff| <= 2c: {(diff.abs() <= 2).mean()*100:.0f}%, "
          f"|diff| > 5c: {(diff.abs() > 5).mean()*100:.0f}%")

    # Queue depth
    print("\nComputing queue depth...")
    sweeps = detect_sweeps(post_trades)
    qd = compute_queue_depth(sweeps)
    depth_map = qd.set_index("ticker")["estimated_queue_depth"].to_dict()
    del sweeps, qd
    gc.collect()

    # Run sweeps
    print(f"\nRunning sweep with trade-derived prices (size={TARGET_SIZE})...")
    sw_t0 = time.time()
    results_trade = run_sweep(entries_trade_c, post_trades, depth_map, "trade")
    print(f"  Done in {time.time()-sw_t0:.1f}s")

    print(f"\nRunning sweep with snapshot NO bid prices (size={TARGET_SIZE})...")
    sw_t0 = time.time()
    results_snap = run_sweep(entries_snap_c, post_trades, depth_map, "snapshot")
    print(f"  Done in {time.time()-sw_t0:.1f}s")

    # Combine and display
    results = pd.concat([results_trade, results_snap], ignore_index=True)
    results.to_csv(OUT_DIR / "snapshot_vs_trades.csv", index=False)

    print("\n" + "=" * 100)
    print("  SPREAD SWEEP: TRADE-DERIVED vs SNAPSHOT NO BID (size=100, common tickers)")
    print("=" * 100)
    print(f"  {'Source':<10} {'Adj':>4} {'PnL':>10} {'Filled':>8} "
          f"{'$/ct':>8} {'Sharpe':>7} {'Entered':>8} {'Filled':>8}")
    print(f"  {'-'*72}")

    for _, r in results.sort_values(["adj", "source"]).iterrows():
        s = f"{r['sharpe']:.2f}" if not np.isnan(r['sharpe']) else "  N/A"
        print(f"  {r['source']:<10} {int(r['adj']):>+4d} ${r['total_pnl']:>+9.0f} "
              f"{r['total_filled']:>8.0f} ${r['pnl_per_ct']:>+.4f} "
              f"{s:>7} {int(r['n_entered']):>8} {int(r['n_filled']):>8}")

    # Find best adj for each source
    print(f"\n  {'='*72}")
    print(f"  BEST ADJ BY SOURCE:")
    print(f"  {'='*72}")
    for source in ["trade", "snapshot"]:
        sub = results[results["source"] == source]
        best_pnl = sub.loc[sub["total_pnl"].idxmax()]
        best_sharpe = sub.loc[sub["sharpe"].idxmax()]
        print(f"  {source}: Best PnL at adj={int(best_pnl['adj']):+d} "
              f"(${best_pnl['total_pnl']:+,.0f}), "
              f"Best Sharpe at adj={int(best_sharpe['adj']):+d} "
              f"({best_sharpe['sharpe']:.2f})")

    print(f"\n  Total runtime: {time.time()-t0:.0f}s")


if __name__ == "__main__":
    main()
